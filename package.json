{
  "name": "infinite-slider-react",
  "version": "1.0.0",
  "description": "High-fidelity scalar input with variable sensitivity for React",
  "type": "module",
  "main": "dist/infinite-slider.cjs",
  "module": "dist/infinite-slider.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/infinite-slider.js",
      "require": "./dist/infinite-slider.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:demo": "vite build --config vite.demo.config.ts"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0"
  },
  "keywords": [
    "react",
    "slider",
    "input",
    "infinite",
    "precision"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.18.3"
}
